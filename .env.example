# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# APP_PASSWORD: СИЛЬНЫЙ пароль для доступа
# Требует: 8+ символов, заглавные, строчные, цифры
APP_PASSWORD="SecurePass123"

# JWT_SECRET: Секрет для подписи JWT токенов
# Используется для аутентификации сессий
JWT_SECRET="your_super_secret_jwt_key_change_this_12345678"

# ============================================
# AI PROVIDERS - API KEYS (ТОЛЬКО НА СЕРВЕРЕ!)
# ============================================
# НИКОГДА не распространяйте эти ключи!
# Они используются ТОЛЬКО на сервере

# Google Gemini API Key
GEMINI_API_KEY="sk-ant-v0-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OpenAI API Key
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Anthropic Claude API Key
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================
# DATABASE & SECURITY
# ============================================
# NODE_ENV: development или production
NODE_ENV="production"

# DATABASE_ENCRYPTION_KEY: Ключ для шифрования данных пациентов
# ГЕНЕРИРУЕТСЯ автоматически при первом запуске, если не указан
# Копировать из консоли при первом запуске!
DATABASE_ENCRYPTION_KEY=""

# ============================================
# APPLICATION SETTINGS
# ============================================
PORT="3000"

# APP_URL: Где развернуто приложение (для CORS)
APP_URL="https://your-domain.com"

# ALLOWED_ORIGINS: Разрешённые источники (через запятую)
ALLOWED_ORIGINS="http://localhost:3000,https://your-domain.com"

# ============================================
# LOGGING & MONITORING
# ============================================
# LOG_LEVEL: debug, info, warn, error
LOG_LEVEL="info"

# LOG_API_CALLS: Логировать ли все API запросы (true/false)
LOG_API_CALLS="true"

# ============================================
# RATE LIMITING
# ============================================
# RATE_LIMIT_WINDOW_MS: Временное окно (в миллисекундах)
RATE_LIMIT_WINDOW_MS="60000"

# RATE_LIMIT_MAX_REQUESTS: Макс запросов в окно
RATE_LIMIT_MAX_REQUESTS="100"
