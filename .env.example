# API_KEY: Основной ключ AI-провайдера (рекомендуемый универсальный вариант).
# Для обратной совместимости также поддерживаются GEMINI_API_KEY и GOOGLE_API_KEY.
API_KEY="MY_AI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Укажите URL, где развернуто приложение (опционально).
# Используется для self-ссылок и API endpoint-ов.
APP_URL="MY_APP_URL"
